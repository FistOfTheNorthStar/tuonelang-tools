// dns::message — the header and question sections, and the query a resolver
// puts on the wire (RFC 1035 §4.1.1–§4.1.2).
//
// Every DNS message, in both directions, begins with the same 12-byte header:
//
//     id (16) | flags (16) | qdcount | ancount | nscount | arcount
//
// and the flags word packs eight fields into those sixteen bits:
//
//     QR(1) OPCODE(4) AA(1) TC(1) RD(1) | RA(1) Z(3) RCODE(4)
//
// Bit-packing is where hand-written DNS code goes wrong, because every field
// is a different width at a different offset and the compiler cannot help.
// So each accessor is named, spec'd, and derived from one shared shift/mask
// pair rather than open-coded — and the round-trip specs prove that packing
// then unpacking a flags word is the identity across every field at once,
// which is the property a bit-twiddling bug actually breaks.

module dns::message;

// ----------------------------------------------------------------------------
// Header field offsets. Written as functions because v0 has no `const` items.
// ----------------------------------------------------------------------------

/// Byte offset of the message id within the header.
///
/// # Example
/// ```tuo
/// let n = dns::message::id_offset(); // 0
/// ```
pub fn id_offset() -> Int {
    0
}

/// Byte offset of the flags word.
///
/// # Example
/// ```tuo
/// let n = dns::message::flags_offset(); // 2
/// ```
pub fn flags_offset() -> Int {
    2
}

/// Byte offset of the question count.
///
/// # Example
/// ```tuo
/// let n = dns::message::qdcount_offset(); // 4
/// ```
pub fn qdcount_offset() -> Int {
    4
}

/// Byte offset of the answer count.
///
/// # Example
/// ```tuo
/// let n = dns::message::ancount_offset(); // 6
/// ```
pub fn ancount_offset() -> Int {
    6
}

/// Byte offset of the authority-record count.
///
/// # Example
/// ```tuo
/// let n = dns::message::nscount_offset(); // 8
/// ```
pub fn nscount_offset() -> Int {
    8
}

/// Byte offset of the additional-record count.
///
/// # Example
/// ```tuo
/// let n = dns::message::arcount_offset(); // 10
/// ```
pub fn arcount_offset() -> Int {
    10
}

// ----------------------------------------------------------------------------
// Record types and classes — the subset a stub resolver needs (RFC 1035 §3.2).
// ----------------------------------------------------------------------------

/// `A` — a 32-bit IPv4 address (type 1).
///
/// # Example
/// ```tuo
/// let n = dns::message::type_a(); // 1
/// ```
pub fn type_a() -> Int {
    1
}

/// `NS` — an authoritative name server (type 2).
///
/// # Example
/// ```tuo
/// let n = dns::message::type_ns(); // 2
/// ```
pub fn type_ns() -> Int {
    2
}

/// `CNAME` — the canonical name for an alias (type 5).
///
/// # Example
/// ```tuo
/// let n = dns::message::type_cname(); // 5
/// ```
pub fn type_cname() -> Int {
    5
}

/// `AAAA` — a 128-bit IPv6 address (type 28, RFC 3596).
///
/// # Example
/// ```tuo
/// let n = dns::message::type_aaaa(); // 28
/// ```
pub fn type_aaaa() -> Int {
    28
}

/// `IN` — the Internet class (class 1).
///
/// # Example
/// ```tuo
/// let n = dns::message::class_in(); // 1
/// ```
pub fn class_in() -> Int {
    1
}

// ----------------------------------------------------------------------------
// Response codes (RFC 1035 §4.1.1).
// ----------------------------------------------------------------------------

/// `NOERROR` — the query succeeded (rcode 0).
///
/// # Example
/// ```tuo
/// let n = dns::message::rcode_noerror(); // 0
/// ```
pub fn rcode_noerror() -> Int {
    0
}

/// `FORMERR` — the server could not interpret the query (rcode 1).
///
/// # Example
/// ```tuo
/// let n = dns::message::rcode_formerr(); // 1
/// ```
pub fn rcode_formerr() -> Int {
    1
}

/// `SERVFAIL` — the server failed to process the query (rcode 2).
///
/// # Example
/// ```tuo
/// let n = dns::message::rcode_servfail(); // 2
/// ```
pub fn rcode_servfail() -> Int {
    2
}

/// `NXDOMAIN` — the name does not exist (rcode 3).
///
/// This is the one error a caller must distinguish from the rest: it is a
/// definitive negative answer, not a failure to get one, and a resolver that
/// retries it is asking a question already answered.
///
/// # Example
/// ```tuo
/// let n = dns::message::rcode_nxdomain(); // 3
/// ```
pub fn rcode_nxdomain() -> Int {
    3
}

/// `REFUSED` — the server refused the query (rcode 5).
///
/// # Example
/// ```tuo
/// let n = dns::message::rcode_refused(); // 5
/// ```
pub fn rcode_refused() -> Int {
    5
}

// ----------------------------------------------------------------------------
// The flags word.
//
// One shift/mask pair per field, so a field is described exactly once and both
// the getter and the packer are derived from that description.
// ----------------------------------------------------------------------------

/// Extract the `width`-bit field whose least significant bit sits at `shift`
/// within the 16-bit `flags` word.
///
/// Every accessor below is this function at a different offset, which is what
/// keeps the bit layout stated once rather than re-derived per field.
///
/// # Example
/// ```tuo
/// let rd = dns::message::field(256, 8, 1); // 1
/// ```
pub fn field(take flags: Int, take shift: Int, take width: Int) -> Int {
    let mask = (1 << width) - 1;
    (flags >> shift) & mask
}

/// `QR` — 0 in a query, 1 in a response (bit 15).
///
/// # Example
/// ```tuo
/// let qr = dns::message::qr(32768); // 1
/// ```
pub fn qr(take flags: Int) -> Int {
    field(flags, 15, 1)
}

/// `OPCODE` — 0 for a standard query (bits 11–14).
///
/// # Example
/// ```tuo
/// let op = dns::message::opcode(256); // 0
/// ```
pub fn opcode(take flags: Int) -> Int {
    field(flags, 11, 4)
}

/// `AA` — the answer is authoritative (bit 10).
///
/// # Example
/// ```tuo
/// let aa = dns::message::aa(1024); // 1
/// ```
pub fn aa(take flags: Int) -> Int {
    field(flags, 10, 1)
}

/// `TC` — the response was **truncated** and the query should be retried over
/// TCP (bit 9).
///
/// This is the bit a UDP-only resolver must never ignore. A truncated response
/// is not a short answer; it is a partial one, and treating it as complete is
/// how a resolver silently returns a subset of a record set.
///
/// # Example
/// ```tuo
/// let tc = dns::message::tc(512); // 1
/// ```
pub fn tc(take flags: Int) -> Int {
    field(flags, 9, 1)
}

/// `RD` — recursion desired, set by a stub resolver asking a recursive server
/// to do the work (bit 8).
///
/// # Example
/// ```tuo
/// let rd = dns::message::rd(256); // 1
/// ```
pub fn rd(take flags: Int) -> Int {
    field(flags, 8, 1)
}

/// `RA` — recursion available, set by the server (bit 7).
///
/// # Example
/// ```tuo
/// let ra = dns::message::ra(128); // 1
/// ```
pub fn ra(take flags: Int) -> Int {
    field(flags, 7, 1)
}

/// `RCODE` — the response code (bits 0–3).
///
/// # Example
/// ```tuo
/// let rc = dns::message::rcode(3); // 3
/// ```
pub fn rcode(take flags: Int) -> Int {
    field(flags, 0, 4)
}

/// Pack a flags word from its fields — the inverse of the accessors above.
///
/// # Example
/// ```tuo
/// let f = dns::message::pack_flags(0, 0, 0, 0, 1, 0, 0); // 256
/// ```
pub fn pack_flags(take qr_bit: Int, take opcode_bits: Int, take aa_bit: Int, take tc_bit: Int, take rd_bit: Int, take ra_bit: Int, take rcode_bits: Int) -> Int {
    ((qr_bit & 1) << 15) | ((opcode_bits & 15) << 11) | ((aa_bit & 1) << 10) | ((tc_bit & 1) << 9) | ((rd_bit & 1) << 8) | ((ra_bit & 1) << 7) | (rcode_bits & 15)
}

/// The flags word a stub resolver sends: a standard query with recursion
/// desired, and nothing else set.
///
/// # Example
/// ```tuo
/// let f = dns::message::query_flags(); // 256
/// ```
pub fn query_flags() -> Int {
    pack_flags(0, 0, 0, 0, 1, 0, 0)
}

// ----------------------------------------------------------------------------
// Building a query.
// ----------------------------------------------------------------------------

/// Build a complete standard query for `name`/`qtype` with message id `id`.
///
/// Returns the datagram, or `None` when the name is not encodable. The message
/// is a 12-byte header with `qdcount = 1` followed by the single question.
///
/// # Example
/// ```tuo
/// // dns::message::build_query(4660, "example.com", 1)
/// ```
pub fn build_query(take id: Int, in name: Str, take qtype: Int) -> Option[String] {
    var buf = std::string::empty();
    dns::wire::put_u16(buf, id);
    dns::wire::put_u16(buf, query_flags());
    dns::wire::put_u16(buf, 1);
    dns::wire::put_u16(buf, 0);
    dns::wire::put_u16(buf, 0);
    dns::wire::put_u16(buf, 0);
    if !dns::name::encode(buf, name) {
        return None;
    }
    dns::wire::put_u16(buf, qtype);
    dns::wire::put_u16(buf, class_in());
    Some { value: buf }
}

// ----------------------------------------------------------------------------
// Reading a header.
// ----------------------------------------------------------------------------

/// The `U16` header field at byte `at` of `msg`, or `None` when the datagram
/// is too short to be a DNS message at all.
///
/// Every header accessor goes through this, so "the datagram is shorter than a
/// header" is decided once rather than per field.
///
/// # Example
/// ```tuo
/// // dns::message::header_field(msg, dns::message::id_offset())
/// ```
pub fn header_field(in msg: Str, take at: Int) -> Option[Int] {
    if std::str::len(msg) < dns::wire::header_len() {
        return None;
    }
    dns::wire::u16_at(msg, at)
}

/// The message id of `msg`, or `None` if it is not header-sized.
///
/// A resolver must check this against the id it sent: an off-path attacker
/// forging a response has to guess it, and a resolver that skips the check
/// accepts whatever arrives first.
///
/// # Example
/// ```tuo
/// // dns::message::id(msg)
/// ```
pub fn id(in msg: Str) -> Option[Int] {
    header_field(msg, id_offset())
}

/// The flags word of `msg`, or `None` if it is not header-sized.
///
/// # Example
/// ```tuo
/// // dns::message::flags(msg)
/// ```
pub fn flags(in msg: Str) -> Option[Int] {
    header_field(msg, flags_offset())
}

/// The question count of `msg`.
///
/// # Example
/// ```tuo
/// // dns::message::qdcount(msg)
/// ```
pub fn qdcount(in msg: Str) -> Option[Int] {
    header_field(msg, qdcount_offset())
}

/// The answer count of `msg`.
///
/// # Example
/// ```tuo
/// // dns::message::ancount(msg)
/// ```
pub fn ancount(in msg: Str) -> Option[Int] {
    header_field(msg, ancount_offset())
}

/// The authority-record count of `msg`.
///
/// # Example
/// ```tuo
/// // dns::message::nscount(msg)
/// ```
pub fn nscount(in msg: Str) -> Option[Int] {
    header_field(msg, nscount_offset())
}

/// The additional-record count of `msg`.
///
/// # Example
/// ```tuo
/// // dns::message::arcount(msg)
/// ```
pub fn arcount(in msg: Str) -> Option[Int] {
    header_field(msg, arcount_offset())
}

/// The byte offset just past the question section, or `None` when a question
/// is malformed or the message ends inside one.
///
/// A question is a name followed by a 4-byte type and class, so this walks
/// `qdcount` of them **without following compression pointers** — the offset a
/// record parser starts from is a property of the bytes in the message, not of
/// the names they denote.
///
/// # Example
/// ```tuo
/// // dns::message::answers_offset(msg)
/// ```
pub fn answers_offset(in msg: Str) -> Option[Int] {
    let count = match qdcount(msg) {
        Some { value } => value,
        None => 0 - 1,
    };
    if count < 0 {
        return None;
    }
    var at = dns::wire::header_len();
    var i = 0;
    var failed = false;
    while i < count && !failed {
        let step = match dns::name::encoded_len(msg, at) {
            Some { value } => value,
            None => 0 - 1,
        };
        if step < 0 {
            failed = true;
        } else {
            at = at + step + 4;
            if at > std::str::len(msg) {
                failed = true;
            }
        }
        i = i + 1;
    }
    if failed {
        return None;
    }
    Some { value: at }
}

// ----------------------------------------------------------------------------
// Spec helpers.
// ----------------------------------------------------------------------------

/// Pack a flags word from all seven fields, unpack every one of them, and
/// report whether each survived — the identity property a bit-packing bug
/// breaks.
///
/// This is stronger than testing the fields one at a time: it catches a field
/// whose mask is too wide and silently overwrites its neighbour, which is the
/// mistake a per-field test passes straight over.
///
/// # Example
/// ```tuo
/// let ok = dns::message::flags_roundtrip(1, 0, 1, 1, 1, 1, 3); // true
/// ```
pub fn flags_roundtrip(take qr_bit: Int, take opcode_bits: Int, take aa_bit: Int, take tc_bit: Int, take rd_bit: Int, take ra_bit: Int, take rcode_bits: Int) -> Bool {
    let f = pack_flags(qr_bit, opcode_bits, aa_bit, tc_bit, rd_bit, ra_bit, rcode_bits);
    qr(f) == qr_bit && opcode(f) == opcode_bits && aa(f) == aa_bit && tc(f) == tc_bit && rd(f) == rd_bit && ra(f) == ra_bit && rcode(f) == rcode_bits
}

/// The number of bytes `build_query` produces for `name`, or `-1` if refused.
///
/// # Example
/// ```tuo
/// let n = dns::message::query_size("example.com"); // 29
/// ```
pub fn query_size(in name: Str) -> Int {
    match build_query(4660, name, type_a()) {
        Some { value } => std::str::len(std::string::as_str(value)),
        None => 0 - 1,
    }
}

/// Byte `i` of the query `build_query` produces for `name`, or `-1`.
///
/// # Example
/// ```tuo
/// let b = dns::message::query_byte("example.com", 0); // 18
/// ```
pub fn query_byte(in name: Str, take i: Int) -> Int {
    let built = match build_query(4660, name, type_a()) {
        Some { value } => value,
        None => std::string::empty(),
    };
    let s = std::string::as_str(built);
    if std::str::len(s) == 0 {
        return 0 - 1;
    }
    if i < 0 {
        return 0 - 1;
    }
    if i >= std::str::len(s) {
        return 0 - 1;
    }
    std::str::byte_at(s, i)
}

/// Build a query, then read a header field back out of it with the decoders —
/// so the builder and the reader are proven against each other rather than
/// each against a hand-written constant.
///
/// # Example
/// ```tuo
/// let n = dns::message::query_header_at(4660, 0); // 4660 — the id
/// ```
pub fn query_header_at(take message_id: Int, take at: Int) -> Int {
    match build_query(message_id, "example.com", type_a()) {
        Some { value } => match header_field(std::string::as_str(value), at) {
            Some { value } => value,
            None => 0 - 1,
        },
        None => 0 - 1,
    }
}

/// `answers_offset` over a freshly built query for `name`, with `-1` for
/// `None`.
///
/// For a query the answer section starts at the very end of the message, so
/// this must equal the query's own length — the cross-check that the question
/// walker and the question builder agree.
///
/// # Example
/// ```tuo
/// let n = dns::message::query_answers_offset("example.com"); // 29
/// ```
pub fn query_answers_offset(in name: Str) -> Int {
    match build_query(4660, name, type_a()) {
        Some { value } => match answers_offset(std::string::as_str(value)) {
            Some { value } => value,
            None => 0 - 1,
        },
        None => 0 - 1,
    }
}

/// `id` over a message of `n` zero bytes, with `-1` for `None` — the
/// short-datagram guard.
///
/// # Example
/// ```tuo
/// let v = dns::message::id_of_zeros(11); // -1: shorter than a header
/// ```
pub fn id_of_zeros(take n: Int) -> Int {
    var buf = std::string::empty();
    var i = 0;
    while i < n {
        std::string::push_byte(buf, 0);
        i = i + 1;
    }
    match id(std::string::as_str(buf)) {
        Some { value } => value,
        None => 0 - 1,
    }
}

spec field {
    // The RD bit, which is bit 8 and the one every stub query sets.
    then field(256, 8, 1) == 1;
    then field(0, 8, 1) == 0;
    // A 4-bit field at the bottom: the rcode.
    then field(3, 0, 4) == 3;
    then field(15, 0, 4) == 15;
    // A field reads only its own bits, not its neighbours'.
    then field(65535, 8, 1) == 1;
    then field(65535, 11, 4) == 15;
}

spec query_flags {
    // Recursion desired, and nothing else.
    then query_flags() == 256;
    then rd(query_flags()) == 1;
    then qr(query_flags()) == 0;
    then opcode(query_flags()) == 0;
    then tc(query_flags()) == 0;
    then rcode(query_flags()) == 0;
}

spec flags_roundtrip {
    // Every field at once, which is what catches a mask that overruns its
    // neighbour — the bug a per-field test cannot see.
    then flags_roundtrip(0, 0, 0, 0, 0, 0, 0);
    then flags_roundtrip(1, 1, 1, 1, 1, 1, 1);
    then flags_roundtrip(1, 15, 1, 1, 1, 1, 15);
    // A standard stub query.
    then flags_roundtrip(0, 0, 0, 0, 1, 0, 0);
    // An authoritative NXDOMAIN response.
    then flags_roundtrip(1, 0, 1, 0, 1, 1, 3);
    // A truncated response, the case a UDP resolver must retry over TCP.
    then flags_roundtrip(1, 0, 0, 1, 1, 1, 0);
}

spec tc {
    // Truncation is bit 9, and reads independently of every other bit.
    then tc(512) == 1;
    then tc(0) == 0;
    then tc(pack_flags(1, 0, 1, 1, 1, 1, 3)) == 1;
    then tc(pack_flags(1, 15, 1, 0, 1, 1, 15)) == 0;
}

spec rcode {
    then rcode(pack_flags(1, 0, 0, 0, 1, 1, rcode_noerror())) == 0;
    then rcode(pack_flags(1, 0, 0, 0, 1, 1, rcode_nxdomain())) == 3;
    then rcode(pack_flags(1, 0, 0, 0, 1, 1, rcode_refused())) == 5;
    // The rcode is the low nibble and must not pick up the flags above it.
    then rcode(65535 - 15) == 0;
}

spec query_size {
    // 12-byte header + 13-byte name + 4 bytes of type and class.
    then query_size("example.com") == 29;
    then query_size("www.example.com") == 33;
    // The root: header + one zero octet + type and class.
    then query_size("") == 17;
    then query_size("a..b") == 0 - 1;
}

spec query_byte {
    // The id, big-endian.
    then query_byte("example.com", 0) == 18;
    then query_byte("example.com", 1) == 52;
    // The flags word: recursion desired.
    then query_byte("example.com", 2) == 1;
    then query_byte("example.com", 3) == 0;
    // qdcount = 1.
    then query_byte("example.com", 4) == 0;
    then query_byte("example.com", 5) == 1;
    // ancount = 0, and the question begins at byte 12 with a 7-byte label.
    then query_byte("example.com", 7) == 0;
    then query_byte("example.com", 12) == 7;
    // Type A and class IN close the message.
    then query_byte("example.com", 26) == 1;
    then query_byte("example.com", 28) == 1;
}

spec query_header_at {
    // The builder and the header reader agree about the id...
    then query_header_at(4660, 0) == 4660;
    then query_header_at(0, 0) == 0;
    then query_header_at(65535, 0) == 65535;
    // ...the flags...
    then query_header_at(4660, 2) == 256;
    // ...and every count.
    then query_header_at(4660, 4) == 1;
    then query_header_at(4660, 6) == 0;
    then query_header_at(4660, 8) == 0;
    then query_header_at(4660, 10) == 0;
}

spec query_answers_offset {
    // A query's answer section starts exactly where the message ends, so the
    // question walker and the question builder must report the same number.
    then query_answers_offset("example.com") == 29;
    then query_answers_offset("www.example.com") == 33;
    then query_answers_offset("") == 17;
}

spec id_of_zeros {
    // A datagram shorter than a 12-byte header is refused rather than read.
    then id_of_zeros(0) == 0 - 1;
    then id_of_zeros(11) == 0 - 1;
    then id_of_zeros(12) == 0;
}
