// x509::fixture — certificates the specs and oracles parse and validate.
//
// Three test PKIs (root, intermediate, leaf) were generated with OpenSSL
// 3.6 on 2026-09-15 for `CN=localhost` with SANs `localhost`,
// `example.test`, and `*.wild.test`; the roots and intermediates are
// valid 2026-01-01 to 2046-01-01 and the leaves 2026-09-01 to 2046-01-01.
// The RSA-1024 PKI exists so the chain walk can run inside the spec
// sandbox; the P-256/P-384 and RSA-2048 PKIs are served by `openssl
// s_server` in `run-tests.sh --live` and validated natively. Their keys
// are in `examples/tls-test/`; they authenticate nothing but this
// repository's own test servers.
//
// The public chains were captured from the named servers with `openssl
// s_client -showcerts` on 2026-09-15 and are validated against the root
// store at that date by `examples/x509.tuo`. They are real certificates;
// most will have expired by the time you read this, which is exactly what
// the oracle's "expired at a later date" checks rely on.
//
// Every value is lowercase hex; `ec::field::hex_bytes` decodes one.

module x509::fixture;

/// The test PKI's RSA-1024, sha256WithRSAEncryption: the root certificate.
///
/// # Example
/// ```tuo
/// let der = ec::field::hex_bytes(x509::fixture::rsa_root());
/// ```
pub fn rsa_root() -> Str {
    ""
}

