// x509::roots — the trust anchors `https://` chains must end at.
//
// 17 root certificates, copied from the Mozilla CA bundle as
// shipped by Python's `certifi` 2026.06.17 (the bundle the backend's own
// `requests` and `httpx` trust). This is not the whole bundle — that is
// about 140 roots — but the ones the backend's integrations chain to,
// plus the other large public CAs, so that a chain from Let's Encrypt,
// Google Trust Services, DigiCert, SSL.com, Amazon, or Microsoft
// validates. Adding a root is adding one base64 line here; the spec
// below insists every entry decodes to a self-issued CA certificate.
//
// A root is trusted by presence: its own signature is not checked (it is
// self-signed, which proves nothing) and neither are its dates, as
// browsers also do not. What is checked is that the next certificate
// down was signed by the root's key.

module x509::roots;

/// How many roots the store holds.
///
/// # Example
/// ```tuo
/// let n = x509::roots::count(); // 17
/// ```
pub fn count() -> Int {
    17
}

/// The Mozilla bundle label of root `index`, or empty past the end.
///
/// # Example
/// ```tuo
/// let s = x509::roots::label(0);
/// ```
pub fn label(take index: Int) -> Str {
    if index == 0 {
        return "ISRG Root X1";
    }
    if index == 1 {
        return "ISRG Root X2";
    }
    if index == 2 {
        return "GTS Root R1";
    }
    if index == 3 {
        return "GTS Root R3";
    }
    if index == 4 {
        return "GTS Root R4";
    }
    if index == 5 {
        return "DigiCert Global Root G2";
    }
    if index == 6 {
        return "DigiCert Global Root G3";
    }
    if index == 7 {
        return "DigiCert Assured ID Root G2";
    }
    if index == 8 {
        return "DigiCert TLS RSA4096 Root G5";
    }
    if index == 9 {
        return "DigiCert TLS ECC P384 Root G5";
    }
    if index == 10 {
        return "SSL.com Root Certification Authority ECC";
    }
    if index == 11 {
        return "Amazon Root CA 1";
    }
    if index == 12 {
        return "Amazon Root CA 2";
    }
    if index == 13 {
        return "Amazon Root CA 3";
    }
    if index == 14 {
        return "Amazon Root CA 4";
    }
    if index == 15 {
        return "Microsoft RSA Root Certificate Authority 2017";
    }
    if index == 16 {
        return "Microsoft ECC Root Certificate Authority 2017";
    }
    ""
}

/// The base64 DER of root `index`, as the PEM body, or empty past the end.
///
/// # Example
/// ```tuo
/// let s = x509::roots::base64_at(0);
/// ```
pub fn base64_at(take index: Int) -> Str {
    if index == 0 {
        return "";
    }
    if index == 1 {
        return "";
    }
    if index == 2 {
        return "";
    }
    if index == 3 {
        return "";
    }
    if index == 4 {
        return "";
    }
    if index == 5 {
        return "";
    }
    if index == 6 {
        return "";
    }
    if index == 7 {
        return "";
    }
    if index == 8 {
        return "";
    }
    if index == 9 {
        return "";
    }
    if index == 10 {
        return "";
    }
    if index == 11 {
        return "";
    }
    if index == 12 {
        return "";
    }
    if index == 13 {
        return "";
    }
    if index == 14 {
        return "";
    }
    if index == 15 {
        return "";
    }
    if index == 16 {
        return "";
    }
    ""
}

/// The DER of root `index`.
///
/// # Example
/// ```tuo
/// let der = x509::roots::der_at(0);
/// ```
pub fn der_at(take index: Int) -> Array[Int] {
    std::crypto::base64_decode(base64_at(index))
}

/// The whole store as an `x509::chain` list.
///
/// # Example
/// ```tuo
/// let roots = x509::roots::store();
/// ```
pub fn store() -> Array[Int] {
    var list = std::array::empty();
    var i = 0;
    while i < count() {
        x509::chain::push_entry(list, der_at(i));
        i = i + 1;
    }
    list
}

/// The index of the root whose label is `name`, or -1.
///
/// # Example
/// ```tuo
/// let i = x509::roots::index_of("ISRG Root X1");
/// ```
pub fn index_of(in name: Str) -> Int {
    var i = 0;
    while i < count() {
        if label(i) == name {
            return i;
        }
        i = i + 1;
    }
    0 - 1
}

fn all_self_issued_cas() -> Bool {
    var i = 0;
    while i < count() {
        let c = x509::certificate::parse(der_at(i));
        if !c.ok || !c.is_ca || !x509::certificate::self_issued(c) || c.key_kind == x509::certificate::key_none() {
            return false;
        }
        i = i + 1;
    }
    true
}

spec store {
    then count() == 17;
    then x509::chain::entry_count(store()) == 17;
    then all_self_issued_cas();
    then index_of("ISRG Root X1") == 0;
    then index_of("GTS Root R4") >= 0;
    then index_of("DigiCert Global Root G2") >= 0;
    then index_of("nobody") == 0 - 1;
    then std::str::len(label(count())) == 0;
    then std::array::len(der_at(count())) == 0;
    then x509::certificate::parse(der_at(index_of("ISRG Root X2"))).key_kind == x509::certificate::key_p384();
    then x509::certificate::parse(der_at(index_of("ISRG Root X1"))).key_kind == x509::certificate::key_rsa();
}
