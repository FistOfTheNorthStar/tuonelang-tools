    }
    if index == 15 {
        return "*2\r\n$3\r\nGET\r\n$67\r\nLIMITS:LIMITER/10.0.0.1//api/v1/job_applicant/auth/login/5/1/minute\r\n";
    }
    ""
}

/// The replies redis-py read for call `index`, back to back.
///
/// # Example
/// ```tuo
/// let v = ratelimit::fixture::redis_replies(0);
/// ```
pub fn redis_replies(take index: Int) -> Str {
    if index == 0 {
        return "+PONG\r\n";
    }
    if index == 1 {
        return "-NOSCRIPT No matching script. Please use EVAL.\r\n$40\r\n628bd136a573a06b346879695681af12ccef300f\r\n:1\r\n";
    }
    if index == 2 {
        return ":2\r\n";
    }
    if index == 3 {
        return ":3\r\n";
    }
    if index == 4 {
        return ":4\r\n";
    }
    if index == 5 {
        return ":5\r\n";
    }
    if index == 6 {
        return ":6\r\n";
    }
    if index == 7 {
        return "$1\r\n6\r\n:60\r\n";
    }
    if index == 8 {
        return "$1\r\n6\r\n";
    }
    if index == 9 {
        return ":3\r\n";
    }
    if index == 10 {
        return "$1\r\n3\r\n";
    }
    if index == 11 {
        return ":4\r\n";
    }
    if index == 12 {
        return "$1\r\n4\r\n:3600\r\n";
    }
    if index == 13 {
        return ":1\r\n";
    }
    if index == 14 {
        return "$-1\r\n:-2\r\n";
    }
    if index == 15 {
        return "$-1\r\n";
    }
    ""
}

