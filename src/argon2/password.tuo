// argon2::password — `shallowflaws`'s `hash_password` / `verify_password`.
//
// The backend does not hash the password directly. `app/api/auth_utils.py`
// first takes SHA-256 of it and hashes the *hex digest* — 64 ASCII bytes —
// with passlib's Argon2 defaults: Argon2id, 64 MiB, three passes, four
// lanes, a 16-byte salt, a 32-byte tag. That pre-hash is what lets a
// password of any length through, and it is part of the stored hash's
// meaning: a verifier that skips it rejects every real user.
//
// This module is that pipeline, minus the one effect in it. Drawing the salt
// is an effect (`std::crypto::nonce`), so `hash` takes the salt as an input
// and the caller draws it — `examples/argon2.tuo` shows the shape. `verify`
// needs no effect at all, which is why it can be spec'd against a hash the
// real backend produced.

module argon2::password;

/// passlib's default memory cost, in KiB: 64 MiB.
///
/// # Example
/// ```tuo
/// let m = argon2::password::memory_kib(); // 65536
/// ```
pub fn memory_kib() -> Int {
    65536
}

/// passlib's default pass count.
///
/// # Example
/// ```tuo
/// let t = argon2::password::passes(); // 3
/// ```
pub fn passes() -> Int {
    3
}

/// passlib's default lane count.
///
/// # Example
/// ```tuo
/// let p = argon2::password::lanes(); // 4
/// ```
pub fn lanes() -> Int {
    4
}

/// passlib's default salt length, in bytes.
///
/// # Example
/// ```tuo
/// let n = argon2::password::salt_len(); // 16
/// ```
pub fn salt_len() -> Int {
    16
}

/// passlib's default tag length, in bytes.
///
/// # Example
/// ```tuo
/// let n = argon2::password::tag_len(); // 32
/// ```
pub fn tag_len() -> Int {
    32
}

/// The bytes Argon2 actually sees: the lowercase hex SHA-256 digest of
/// `password`, as `hashlib.sha256(password.encode("utf-8")).hexdigest()`
/// produces it.
///
/// # Example
/// ```tuo
/// let b = argon2::password::prehash("testpassword"); // 64 bytes, "9f735e0d..."
/// ```
pub fn prehash(in password: Str) -> Array[Int] {
    let digest = std::crypto::sha256(password);
    std::crypto::bytes_of_str(std::string::as_str(digest))
}

/// The PHC string for `password` under `salt` at the given costs — what
/// `hash_password` stores, given the salt it drew.
///
/// # Example
/// ```tuo
/// let s = argon2::password::hash_with("testpassword", salt, 65536, 3, 4);
/// ```
pub fn hash_with(in password: Str, in salt: Array[Int], take memory_kib: Int, take passes: Int, take lanes: Int) -> String {
    let p = argon2::hash::params(lanes, memory_kib, passes, argon2::hash::kind_id(), tag_len());
    let tag = argon2::hash::hash(prehash(password), salt, std::array::empty(), std::array::empty(), p);
    argon2::phc::encode(argon2::hash::kind_id(), memory_kib, passes, lanes, salt, tag)
}

/// `hash_with` at passlib's defaults: the backend's `hash_password`, once
/// the caller has drawn a 16-byte salt.
///
/// # Example
/// ```tuo
/// let salt = std::crypto::nonce(argon2::password::salt_len()); // an effect: not in a spec
/// let s = argon2::password::hash("testpassword", salt);
/// ```
pub fn hash(in password: Str, in salt: Array[Int]) -> String {
    hash_with(password, salt, memory_kib(), passes(), lanes())
}

/// The backend's `verify_password`: whether `password` is the one `encoded`
/// was made from. False for a malformed `encoded`, as the backend's
/// `except ValueError` arm returns.
///
/// # Example
/// ```tuo
/// let ok = argon2::password::verify("testpassword", stored);
/// ```
pub fn verify(in password: Str, in encoded: Str) -> Bool {
    argon2::phc::verify(prehash(password), encoded)
}

// ----------------------------------------------------------------------------
// Spec fixtures. argon2-cffi's `hash_secret` over the pre-hash of
// "testpassword" at a geometry the sandbox can afford; the backend's own
// full-strength hash is asserted natively by `examples/argon2.tuo`.
// ----------------------------------------------------------------------------

/// argon2-cffi's PHC string for the pre-hash of "testpassword" under
/// "somesalt" at m=8, t=1, p=1.
///
/// # Example
/// ```tuo
/// let s = argon2::password::cffi_prehashed();
/// ```
pub fn cffi_prehashed() -> Str {
    "$argon2id$v=19$m=8,t=1,p=1$c29tZXNhbHQ$4x7OClz0uRxgtipIwrlD+5lhfgSni/PkuVz2kCn4jx8"
}

fn prehash_text() -> String {
    std::crypto::str_of_bytes(prehash("testpassword"))
}

fn hashed_small() -> String {
    hash_with("testpassword", std::crypto::bytes_of_str("somesalt"), 8, 1, 1)
}

spec prehash {
    then std::array::len(prehash("testpassword")) == 64;
    then std::string::as_str(prehash_text()) == "9f735e0df9a1ddc702bf0a1a7b83033f9f7153a00c29de82cedadc9957289b05";
    // The empty password pre-hashes too: SHA-256 of nothing is not nothing.
    then std::array::len(prehash("")) == 64;
}

spec hash_with {
    then std::string::as_str(hashed_small()) == cffi_prehashed();
}

spec verify {
    then verify("testpassword", cffi_prehashed()) == true;
    then verify("testpassword ", cffi_prehashed()) == false;
    then verify("Testpassword", cffi_prehashed()) == false;
    then verify("testpassword", "$argon2id$v=19$m=65536,t=3,p=4$fakehash") == false;
    then verify("testpassword", "") == false;
}

spec memory_kib {
    then memory_kib() == 65536;
    then passes() == 3;
    then lanes() == 4;
    then salt_len() == 16;
    then tag_len() == 32;
}
