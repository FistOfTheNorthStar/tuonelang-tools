// web::route — a route table, and what Starlette would do with a request.
//
// A route is a method, a pattern like `/jobs/{job_id}`, and a slot: a
// number the application dispatches on. Handlers themselves are not in
// the table — v0's growable arrays cannot hold function values (the
// finding `examples/router` documents) — so `resolve` answers with a slot
// and the application's `match` on it is the dispatch.
//
// RESOLUTION IS STARLETTE'S, which is what FastAPI routes with:
//
//   * Routes are tried in registration order and the first whose pattern
//     and method both match wins. Order is the only precedence:
//     `/jobs/search` must be registered before `/jobs/{job_id}`, exactly
//     as in the Python it replaces.
//   * A pattern matches a whole path. `{name}` is one non-empty segment,
//     matched after percent-decoding, so `%20` arrives as a space and an
//     encoded `%2F` becomes a separator and does not match.
//   * A path that matches patterns but no method is `405` with `Allow`.
//     Starlette lists only the first such route's method; this lists
//     every method registered for a matching pattern, which is what RFC
//     9110 §15.5.6 asks for and agrees whenever there is one.
//   * A path that matches nothing, but would with its trailing slash
//     added or removed, is a `307` to that path, query kept. Starlette
//     sends an absolute URL; this sends the path, which RFC 9110 permits
//     and which does not need to know the scheme a proxy terminated.
//   * `HEAD` is not implied by `GET`, as it is not in FastAPI.

module web::route;

/// The table.
pub struct Routes {
    methods: Array[String],
    patterns: Array[String],
    slots: Array[Int],
}

/// What a request resolved to. `names` and `values` are the path
/// parameters of a found route.
pub struct Match {
    kind: Int,
    slot: Int,
    names: Array[String],
    values: Array[String],
    allow: String,
    location: String,
}

/// A route was found.
///
/// # Example
/// ```tuo
/// let k = web::route::found(); // 0
/// ```
pub fn found() -> Int {
    0
}

/// Nothing matches: 404.
///
/// # Example
/// ```tuo
/// let k = web::route::not_found(); // 1
/// ```
pub fn not_found() -> Int {
    1
}

/// The path matches but the method does not: 405.
///
/// # Example
/// ```tuo
/// let k = web::route::method_not_allowed(); // 2
/// ```
pub fn method_not_allowed() -> Int {
    2
}

/// The path matches with its trailing slash toggled: 307.
///
/// # Example
/// ```tuo
/// let k = web::route::redirect(); // 3
/// ```
pub fn redirect() -> Int {
    3
}

/// An empty table.
///
/// # Example
/// ```tuo
/// var routes = web::route::new();
/// ```
pub fn new() -> Routes {
    Routes { methods: std::array::empty(), patterns: std::array::empty(), slots: std::array::empty() }
}

/// Register `method pattern` as `slot`.
///
/// # Example
/// ```tuo
/// web::route::add(routes, "GET", "/jobs/{job_id}", 3);
/// ```
pub fn add(mut routes: Routes, in method: Str, in pattern: Str, take slot: Int) {
    std::array::push(routes.methods, std::string::from_str(method));
    std::array::push(routes.patterns, std::string::from_str(pattern));
    std::array::push(routes.slots, slot);
}

/// The offset of the next `/` in `text` at or after `from`, or its length.
fn segment_end(in text: Str, take from: Int) -> Int {
    var i = from;
    while i < std::str::len(text) && std::str::byte_at(text, i) != 47 {
        i = i + 1;
    }
    i
}

/// `text` percent-decoded, `+` left alone: a path is not a form.
fn path_decoded(in text: Str) -> String {
    var out = std::string::empty();
    let n = std::str::len(text);
    var i = 0;
    while i < n {
        let b = std::str::byte_at(text, i);
        if b == 43 {
            std::string::push_byte(out, 43);
            i = i + 1;
        } else if b == 37 {
            let one = http::url::percent_decode(std::string::as_str(http::message::slice(text, i, i + 3)));
            std::string::append(out, std::string::as_str(one));
            i = if std::string::len(one) == 1 {
                i + 3
            } else {
                n
            };
        } else {
            std::string::push_byte(out, b);
            i = i + 1;
        }
    }
    out
}

/// Whether `pattern` matches the decoded `path`, appending the
/// parameters it captured to `names` and `values`.
///
/// # Example
/// ```tuo
/// let ok = web::route::pattern_matches("/jobs/{job_id}", "/jobs/5", names, values);
/// ```
pub fn pattern_matches(in pattern: Str, in path: Str, mut names: Array[String], mut values: Array[String]) -> Bool {
    let pn = std::str::len(pattern);
    let hn = std::str::len(path);
    var p = 0;
    var h = 0;
    var found_names = std::array::empty();
    var found_values = std::array::empty();
    while p < pn {
        if h >= hn || std::str::byte_at(pattern, p) != 47 || std::str::byte_at(path, h) != 47 {
            return false;
        }
        p = p + 1;
        h = h + 1;
        let pe = segment_end(pattern, p);
        let he = segment_end(path, h);
        if pe - p >= 2 && std::str::byte_at(pattern, p) == 123 && std::str::byte_at(pattern, pe - 1) == 125 {
            if he == h {
                return false;
            }
            std::array::push(found_names, http::message::slice(pattern, p + 1, pe - 1));
            std::array::push(found_values, http::message::slice(path, h, he));
        } else {
            if pe - p != he - h {
                return false;
            }
            var k = 0;
            while k < pe - p {
                if std::str::byte_at(pattern, p + k) != std::str::byte_at(path, h + k) {
                    return false;
                }
                k = k + 1;
            }
        }
        p = pe;
        h = he;
    }
    if h != hn {
        return false;
    }
    var i = 0;
    while i < std::array::len(found_names) {
        std::array::push(names, std::string::from_str(std::string::as_str(std::array::get(found_names, i))));
        std::array::push(values, std::string::from_str(std::string::as_str(std::array::get(found_values, i))));
        i = i + 1;
    }
    true
}

fn any_pattern_matches(in routes: Routes, in path: Str) -> Bool {
    var i = 0;
    while i < std::array::len(routes.patterns) {
        var names = std::array::empty();
        var values = std::array::empty();
        if pattern_matches(std::string::as_str(std::array::get(routes.patterns, i)), path, names, values) {
            return true;
        }
        i = i + 1;
    }
    false
}

/// The path part of a request target: everything before `?`.
///
/// # Example
/// ```tuo
/// let p = web::route::path_of("/jobs/search?q=a"); // "/jobs/search"
/// ```
pub fn path_of(in target: Str) -> String {
    var i = 0;
    while i < std::str::len(target) && std::str::byte_at(target, i) != 63 {
        i = i + 1;
    }
    http::message::slice(target, 0, i)
}

/// The query part of a request target: everything after the first `?`.
///
/// # Example
/// ```tuo
/// let q = web::route::query_of("/jobs/search?q=a"); // "q=a"
/// ```
pub fn query_of(in target: Str) -> String {
    var i = 0;
    while i < std::str::len(target) && std::str::byte_at(target, i) != 63 {
        i = i + 1;
    }
    if i >= std::str::len(target) {
        return std::string::empty();
    }
    http::message::slice(target, i + 1, std::str::len(target))
}

/// Resolve `method target` against the table.
///
/// # Example
/// ```tuo
/// let m = web::route::resolve(routes, "GET", "/jobs/5?full=1");
/// ```
pub fn resolve(in routes: Routes, in method: Str, in target: Str) -> Match {
    let raw_path = path_of(target);
    let path = path_decoded(std::string::as_str(raw_path));
    var allow = std::string::empty();
    var i = 0;
    while i < std::array::len(routes.patterns) {
        var names = std::array::empty();
        var values = std::array::empty();
        if pattern_matches(std::string::as_str(std::array::get(routes.patterns, i)), std::string::as_str(path), names, values) {
            let route_method = std::string::from_str(std::string::as_str(std::array::get(routes.methods, i)));
            if std::string::as_str(route_method) == method {
                return Match { kind: found(), slot: std::array::get(routes.slots, i), names: names, values: values, allow: std::string::empty(), location: std::string::empty() };
            }
            if !http::message::list_has(std::string::as_str(allow), std::string::as_str(route_method)) {
                if std::string::len(allow) > 0 {
                    std::string::append(allow, ", ");
                }
                std::string::append(allow, std::string::as_str(route_method));
            }
        }
        i = i + 1;
    }
    if std::string::len(allow) > 0 {
        return Match { kind: method_not_allowed(), slot: 0 - 1, names: std::array::empty(), values: std::array::empty(), allow: allow, location: std::string::empty() };
    }
    let n = std::string::len(path);
    if n > 1 {
        let ends_in_slash = std::string::byte_at(path, n - 1) == 47;
        var other = std::string::empty();
        var other_raw = std::string::empty();
        let rn = std::string::len(raw_path);
        if ends_in_slash {
            other = http::message::slice(std::string::as_str(path), 0, n - 1);
            other_raw = http::message::slice(std::string::as_str(raw_path), 0, rn - 1);
        } else {
            other = std::string::from_str(std::string::as_str(path));
            std::string::push_byte(other, 47);
            other_raw = std::string::from_str(std::string::as_str(raw_path));
            std::string::push_byte(other_raw, 47);
        }
        if any_pattern_matches(routes, std::string::as_str(other)) {
            let query = query_of(target);
            if std::string::len(query) > 0 {
                std::string::push_byte(other_raw, 63);
                std::string::append(other_raw, std::string::as_str(query));
            }
            return Match { kind: redirect(), slot: 0 - 1, names: std::array::empty(), values: std::array::empty(), allow: std::string::empty(), location: other_raw };
        }
    }
    Match { kind: not_found(), slot: 0 - 1, names: std::array::empty(), values: std::array::empty(), allow: std::string::empty(), location: std::string::empty() }
}

/// The value of path parameter `name` in a match, or empty.
///
/// # Example
/// ```tuo
/// let id = web::route::param(m, "job_id");
/// ```
pub fn param(in m: Match, in name: Str) -> String {
    var i = 0;
    while i < std::array::len(m.names) {
        if std::string::as_str(std::array::get(m.names, i)) == name {
            return std::string::from_str(std::string::as_str(std::array::get(m.values, i)));
        }
        i = i + 1;
    }
    std::string::empty()
}

// --- Specs: the table of the FastAPI app the oracle captured -----------------

fn table() -> Routes {
    var r = new();
    add(r, "POST", "/api/v1/job_applicant/auth/register", 1);
    add(r, "GET", "/jobs/search", 2);
    add(r, "GET", "/jobs/{job_id}", 3);
    add(r, "DELETE", "/photos/{photo_id}", 4);
    add(r, "GET", "/files/{owner_type}/{filename}", 5);
    add(r, "GET", "/me", 6);
    add(r, "PATCH", "/me", 7);
    r
}

fn kind_of(in method: Str, in target: Str) -> Int {
    let m = resolve(table(), method, target);
    m.kind
}

fn slot_of(in method: Str, in target: Str) -> Int {
    let m = resolve(table(), method, target);
    m.slot
}

fn text_is(in actual: String, in expected: Str) -> Bool {
    std::string::as_str(actual) == expected
}

fn allow_of(in method: Str, in target: Str) -> String {
    let m = resolve(table(), method, target);
    m.allow
}

fn location_of(in method: Str, in target: Str) -> String {
    let m = resolve(table(), method, target);
    m.location
}

spec resolve {
    then slot_of("POST", "/api/v1/job_applicant/auth/register") == 1;
    // Order is the precedence: the static route was registered first.
    then slot_of("GET", "/jobs/search?q=python") == 2;
    then slot_of("GET", "/jobs/5") == 3;
    then slot_of("GET", "/jobs/abc") == 3;
    then slot_of("DELETE", "/photos/3") == 4;
    then slot_of("PATCH", "/me") == 7;
    then kind_of("GET", "/nope") == not_found();
    then kind_of("GET", "/") == not_found();
    then kind_of("GET", "//jobs/5") == not_found();
    then kind_of("GET", "/files/employer/a/b.png") == not_found();
    then kind_of("GET", "/files/employer/a%2Fb.png") == not_found();
    then kind_of("GET", "/jobs") == not_found();
    then kind_of("GET", "/api/v1/job_applicant/auth/register") == method_not_allowed();
    then text_is(allow_of("GET", "/api/v1/job_applicant/auth/register"), "POST");
    then text_is(allow_of("POST", "/photos/3"), "DELETE");
    then text_is(allow_of("DELETE", "/me"), "GET, PATCH");
    then kind_of("HEAD", "/jobs/5") == method_not_allowed();
    then kind_of("GET", "/jobs/5/") == redirect();
    then text_is(location_of("GET", "/jobs/5/"), "/jobs/5");
    then text_is(location_of("GET", "/jobs/search/?q=aa"), "/jobs/search?q=aa");
    // The redirect is decided on the path alone, whatever the method.
    then text_is(location_of("GET", "/photos/3/"), "/photos/3");
}

spec param {
    let m = resolve(table(), "GET", "/files/employer/logo%20one.png");
    then m.kind == found();
    then m.slot == 5;
    then text_is(param(m, "owner_type"), "employer");
    then text_is(param(m, "filename"), "logo one.png");
    then text_is(param(m, "missing"), "");
    then text_is(param(resolve(table(), "GET", "/jobs/-5?x=1"), "job_id"), "-5");
    then text_is(param(resolve(table(), "GET", "/jobs/a+b"), "job_id"), "a+b");
}

spec path_of {
    then text_is(path_of("/jobs/search?q=a?b"), "/jobs/search");
    then text_is(query_of("/jobs/search?q=a?b"), "q=a?b");
    then text_is(path_of("/jobs"), "/jobs");
    then text_is(query_of("/jobs"), "");
    then text_is(query_of("/jobs?"), "");
}
