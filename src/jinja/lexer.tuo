// jinja::lexer — a template as a sequence of text, `{{ }}`, `{% %}`, `{# #}`.
//
// With the two options the backend sets: `trim_blocks` removes the first
// newline after a block tag or a comment, and `lstrip_blocks` removes
// the spaces and tabs from the start of a line up to one. Either can be
// overridden per tag with `-` (strip all whitespace on that side) and
// `+` (strip none), as Jinja allows. Output tags `{{ }}` are never
// trimmed. What comes out is parallel arrays: a kind per token and its
// content — the text itself, or the inside of the tag, trimmed.

module jinja::lexer;

/// A text run.
pub fn kind_text() -> Int {
    0
}

/// `{{ … }}`.
pub fn kind_output() -> Int {
    1
}

/// `{% … %}`.
pub fn kind_block() -> Int {
    2
}

/// The tokens.
pub struct Tokens {
    kinds: Array[Int],
    texts: Array[String],
}

fn find_from(in s: Str, in needle: Str, take from: Int) -> Int {
    let n = std::str::len(s);
    let m = std::str::len(needle);
    var i = from;
    while i + m <= n {
        if std::str::slice(s, i, i + m) == needle {
            return i;
        }
        i = i + 1;
    }
    -1
}

fn is_blank(take b: Int) -> Bool {
    b == 32 || b == 9
}

fn is_space(take b: Int) -> Bool {
    b == 32 || b == 9 || b == 10 || b == 13
}

// The next tag start at or after `from`: `{{`, `{%`, or `{#`; -1 for none.
fn next_tag(in s: Str, take from: Int) -> Int {
    let n = std::str::len(s);
    var i = from;
    while i + 1 < n {
        if std::str::byte_at(s, i) == 123 {
            let c = std::str::byte_at(s, i + 1);
            if c == 123 || c == 37 || c == 35 {
                return i;
            }
        }
        i = i + 1;
    }
    -1
}

fn push(mut t: Tokens, take kind: Int, take text: String) {
    std::array::push(t.kinds, kind);
    std::array::push(t.texts, text);
}

/// Lex `source` with `trim_blocks` and `lstrip_blocks` on.
///
/// # Example
/// ```tuo
/// let t = jinja::lexer::lex("Hi {{ name }}!\n{% if x %}\nyes\n{% endif %}\n");
/// ```
pub fn lex(in source: Str) -> Tokens {
    var out = Tokens { kinds: std::array::empty(), texts: std::array::empty() };
    let n = std::str::len(source);
    var text = std::string::empty();
    var at = 0;
    while at < n {
        let start = next_tag(source, at);
        if start < 0 {
            std::string::append(text, std::str::slice(source, at, n));
            at = n;
        } else {
            std::string::append(text, std::str::slice(source, at, start));
            let opener = std::str::byte_at(source, start + 1);
            let closer = if opener == 123 {
                "}}"
            } else if opener == 37 {
                "%}"
            } else {
                "#}"
            };
            var body_start = start + 2;
            var strip_left = 0;
            if body_start < n && std::str::byte_at(source, body_start) == 45 {
                strip_left = 2;
                body_start = body_start + 1;
            } else if body_start < n && std::str::byte_at(source, body_start) == 43 {
                strip_left = 1;
                body_start = body_start + 1;
            }
            let end = find_from(source, closer, body_start);
            if end < 0 {
                // An unterminated tag is text, as far as it goes.
                std::string::append(text, std::str::slice(source, start, n));
                at = n;
            } else {
                var body_end = end;
                var strip_right = 0;
                if body_end > body_start && std::str::byte_at(source, body_end - 1) == 45 {
                    strip_right = 2;
                    body_end = body_end - 1;
                } else if body_end > body_start && std::str::byte_at(source, body_end - 1) == 43 {
                    strip_right = 1;
                    body_end = body_end - 1;
                }
                // Left side: `-` strips all whitespace; lstrip_blocks strips
                // the line's leading blanks before a block or comment.
                if strip_left == 2 {
                    var k = std::string::len(text);
                    while k > 0 && is_space(std::string::byte_at(text, k - 1)) {
                        k = k - 1;
                    }
                    text = std::string::slice(text, 0, k);
                } else if strip_left == 0 && opener != 123 {
                    var k = std::string::len(text);
                    while k > 0 && is_blank(std::string::byte_at(text, k - 1)) {
                        k = k - 1;
                    }
                    if k == 0 || std::string::byte_at(text, k - 1) == 10 {
                        text = std::string::slice(text, 0, k);
                    }
                }
                if std::string::len(text) > 0 {
                    push(out, kind_text(), std::string::from_str(std::string::as_str(text)));
                }
                text = std::string::empty();
                let inside = std::str::trim(std::str::slice(source, body_start, body_end));
                if opener == 123 {
                    push(out, kind_output(), std::string::from_str(inside));
                } else if opener == 37 {
                    push(out, kind_block(), std::string::from_str(inside));
                }
                at = end + 2;
                // Right side: `-` strips all whitespace; trim_blocks strips
                // one newline after a block or comment.
                if strip_right == 2 {
                    while at < n && is_space(std::str::byte_at(source, at)) {
                        at = at + 1;
                    }
                } else if strip_right == 0 && opener != 123 {
                    if at < n && std::str::byte_at(source, at) == 10 {
                        at = at + 1;
                    } else if at + 1 < n && std::str::byte_at(source, at) == 13 && std::str::byte_at(source, at + 1) == 10 {
                        at = at + 2;
                    }
                }
            }
        }
    }
    if std::string::len(text) > 0 {
        push(out, kind_text(), std::string::from_str(std::string::as_str(text)));
    }
    out
}

/// How many tokens.
///
/// # Example
/// ```tuo
/// let n = jinja::lexer::count(t);
/// ```
pub fn count(in t: Tokens) -> Int {
    std::array::len(t.kinds)
}

/// The kind of token `i`.
///
/// # Example
/// ```tuo
/// let k = jinja::lexer::kind(t, 0);
/// ```
pub fn kind(in t: Tokens, take i: Int) -> Int {
    std::array::get(t.kinds, i)
}

/// The content of token `i`.
///
/// # Example
/// ```tuo
/// let c = jinja::lexer::text(t, 0);
/// ```
pub fn text(in t: Tokens, take i: Int) -> String {
    std::string::from_str(std::string::as_str(std::array::get(t.texts, i)))
}

fn joined(in source: Str) -> String {
    let t = lex(source);
    var out = std::string::empty();
    var i = 0;
    while i < count(t) {
        std::string::push_byte(out, 91);
        std::str::push_int(out, kind(t, i));
        std::string::push_byte(out, 58);
        std::string::append(out, std::string::as_str(text(t, i)));
        std::string::push_byte(out, 93);
        i = i + 1;
    }
    out
}

fn joined_is(in source: Str, in expected: Str) -> Bool {
    std::string::as_str(joined(source)) == expected
}

spec lex {
    then joined_is("Hi {{ name }}!", "[0:Hi ][1:name][0:!]");
    then joined_is("a\n    {% if x %}\nb\n    {% endif %}\nc", "[0:a\n][2:if x][0:b\n][2:endif][0:c]");
    then joined_is("<p>{{ t.x }}</p>\n{# note #}\nz", "[0:<p>][1:t.x][0:</p>\n][0:z]");
    then joined_is("a {{ x }}\nb", "[0:a ][1:x][0:\nb]");
    then joined_is("a  {%- if x -%}  b", "[0:a][2:if x][0:b]");
    then joined_is("  {%+ if x +%}\nb", "[0:  ][2:if x][0:\nb]");
    then joined_is("x {% broken", "[0:x {% broken]");
    then joined_is("", "");
}
