        return "{% extends \"base.txt\" %}\n{% block content %}\n{{ greeting }}\n\n{{ t.vies_failed.body }}\n\n{{ t.vies_failed.label_vat }}: {{ full_vat }}\n{{ t.vies_failed.label_company }}: {{ employer_company_name if employer_company_name else \"\\u2014\" }}\n{% if error_reason %}\n{{ t.vies_failed.label_reason }}\n{% endif %}\n\n{{ t.vies_failed.reasons_intro }}\n- {{ t.vies_failed.reason_incorrect }}\n- {{ t.vies_failed.reason_not_registered }}\n- {{ t.vies_failed.reason_unavailable }}\n\n{{ t.vies_failed.update_notice_text }}\n\n{{ t.vies_failed.account_notice }}\n{% endblock %}\n";
    }
    if index == 28 {
        return "{% extends \"base.html\" %}\n{% block content %}\n<h2 style=\"color: #333; margin-top: 0;\">{{ t.vies_success.heading }}</h2>\n\n<p>{{ greeting }}</p>\n\n<p>{{ t.vies_success.body }}</p>\n\n<div style=\"background: #f0fdf4; border: 1px solid #bbf7d0; border-radius: 8px; padding: 16px; margin: 20px 0;\">\n    <p style=\"margin: 0; color: #16a34a; font-weight: 600;\">&#10003; {{ t.vies_success.status }}</p>\n</div>\n\n<table style=\"width: 100%; border-collapse: collapse; margin: 20px 0;\">\n    <tr>\n        <td style=\"padding: 8px 12px; color: #666;\">{{ t.vies_success.label_vat }}</td>\n        <td style=\"padding: 8px 12px; font-weight: 600;\">{{ full_vat }}</td>\n    </tr>\n    <tr>\n        <td style=\"padding: 8px 12px; color: #666;\">{{ t.vies_success.label_company }}</td>\n        <td style=\"padding: 8px 12px;\">{{ employer_company_name if employer_company_name else \"\\u2014\" }}</td>\n    </tr>\n    {% if vies_name %}\n    {% if name_match_ok %}\n    <tr>\n        <td style=\"padding: 8px 12px; color: #666;\">{{ t.vies_success.label_name_match }}</td>\n        <td style=\"padding: 8px 12px; color: #16a34a; font-weight: 600;\">{{ t.vies_success.name_match_confirmed }}</td>\n    </tr>\n    {% else %}\n    <tr>\n        <td style=\"padding: 8px 12px; color: #666;\">{{ t.vies_success.label_vies_name }}</td>\n        <td style=\"padding: 8px 12px;\">{{ vies_name }}</td>\n    </tr>\n    <tr>\n        <td style=\"padding: 8px 12px; color: #666;\">{{ t.vies_success.label_name_match }}</td>\n        <td style=\"padding: 8px 12px; color: #d97706; font-weight: 600;\">{{ t.vies_success.name_match_partial }}</td>\n    </tr>\n    {% endif %}\n    {% endif %}\n</table>\n\n<p style=\"{{ styles.muted }}\">{{ t.vies_success.auto_notice }}</p>\n{% endblock %}\n";
    }
    if index == 29 {
        return "{% extends \"base.txt\" %}\n{% block content %}\n{{ greeting }}\n\n{{ t.vies_success.body }}\n\n{{ t.vies_success.label_vat }}: {{ full_vat }}\n{{ t.vies_success.label_company }}: {{ employer_company_name if employer_company_name else \"\\u2014\" }}\n{% if vies_name %}\n{% if name_match_ok %}\n{{ t.vies_success.label_name_match }}: {{ t.vies_success.name_match_confirmed }}\n{% else %}\n{{ t.vies_success.label_vies_name }}: {{ vies_name }}\n{{ t.vies_success.label_name_match }}: {{ t.vies_success.name_match_partial }}\n{% endif %}\n{% endif %}\n\n{{ t.vies_success.auto_notice }}\n{% endblock %}\n";
    }
    ""
}

