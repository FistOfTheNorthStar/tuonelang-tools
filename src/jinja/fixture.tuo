        return "{\"greeting\":\"Hi Ada &lt;b&gt;&#34;Lovelace&#34;&lt;/b&gt; &amp; S\u{f6}hne,\",\"reset_url\":\"https://rekryon.example/reset-password/job_applicant?token=tok%3Cen%3E&email=ada%40example.com\",\"expire_text\":\"24 hours\",\"styles\":{\"body\":\"font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; line-height: 1.6; color: #333; max-width: 600px; margin: 0 auto; padding: 20px;\",\"header\":\"background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); padding: 30px; text-align: center; border-radius: 10px 10px 0 0;\",\"header_title\":\"color: white; margin: 0; font-size: 28px;\",\"content\":\"background: #ffffff; padding: 30px; border: 1px solid #e0e0e0; border-top: none; border-radius: 0 0 10px 10px;\",\"button\":\"background: #4f46e5; color: white; padding: 14px 28px; text-decoration: none; border-radius: 8px; font-weight: 600; display: inline-block;\",\"muted\":\"color: #666; font-size: 14px;\",\"footer\":\"text-align: center; padding: 20px; color: #999; font-size: 12px;\",\"link\":\"color: #4f46e5; word-break: break-all;\",\"divider\":\"border: none; border-top: 1px solid #e0e0e0; margin: 30px 0;\"},\"title\":\"Rekryon\",\"company_name\":\"Rekryon <Oy> & Co\",\"preview_text\":null,\"t\":{\"password_reset\":{\"subject\":\"Reset your Rekryon password\",\"heading\":\"Password Reset Request\",\"body\":\"We received a request to reset your password for your Rekryon account. Click the button below to create a new password:\",\"button\":\"Reset Password\",\"expire_notice\":\"This link will expire in 24 hours for security reasons.\",\"ignore_notice\":\"If you didn't request a password reset, you can safely ignore this email. Your password will remain unchanged.\",\"fallback_link\":\"If the button doesn't work, copy and paste this link into your browser:\"}}}";
