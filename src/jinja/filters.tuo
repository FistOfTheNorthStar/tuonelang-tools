// jinja::filters — the filters the templates apply.
//
// One custom filter carries the backend's money: `currency`, which
// `app/emails/base.py` registers as `f"{float(amount):.2f} {currency}"`,
// falling back to `f"{amount} {currency}"` when the amount does not
// parse. A handful of Jinja's built-ins ride along at no cost: `safe`,
// `e`/`escape`, `upper`, `lower`, `trim`, `length`, `default`. A filter
// the port does not know leaves its input unchanged, where Jinja would
// refuse the template.

module jinja::filters;

fn is_digit(take b: Int) -> Bool {
    b >= 48 && b <= 57
}

/// `float(text)` rendered with two decimals, as `f"{x:.2f}"` does for
/// the amounts the backend formats — plain decimal spellings. Empty
/// when the text is not a number.
///
/// # Example
/// ```tuo
/// let t = jinja::filters::two_decimals("12.5"); // "12.50"
/// ```
pub fn two_decimals(in text: Str) -> String {
    let raw = std::str::trim(text);
    let n = std::str::len(raw);
    if n == 0 {
        return std::string::empty();
    }
    var i = 0;
    var negative = false;
    if std::str::byte_at(raw, 0) == 45 || std::str::byte_at(raw, 0) == 43 {
        negative = std::str::byte_at(raw, 0) == 45;
        i = 1;
    }
    var whole = std::string::empty();
    var fraction = std::string::empty();
    var seen_point = false;
    var digits = 0;
    while i < n {
        let b = std::str::byte_at(raw, i);
        if is_digit(b) {
            if seen_point {
                std::string::push_byte(fraction, b);
            } else {
                std::string::push_byte(whole, b);
            }
            digits = digits + 1;
        } else if b == 46 && !seen_point {
            seen_point = true;
        } else {
            return std::string::empty();
        }
        i = i + 1;
    }
    if digits == 0 {
        return std::string::empty();
    }
    // Round half up at the third decimal, carrying into the whole part.
    var cents = std::array::empty();
    var k = 0;
    while k < 2 {
        if k < std::string::len(fraction) {
            std::array::push(cents, std::string::byte_at(fraction, k) - 48);
        } else {
            std::array::push(cents, 0);
        }
        k = k + 1;
    }
    var carry = 0;
    if std::string::len(fraction) > 2 && std::string::byte_at(fraction, 2) >= 53 {
        carry = 1;
    }
    var out_whole = std::string::empty();
    var c1 = std::array::get(cents, 1) + carry;
    var c0 = std::array::get(cents, 0);
    if c1 == 10 {
        c1 = 0;
        c0 = c0 + 1;
    }
    carry = 0;
    if c0 == 10 {
        c0 = 0;
        carry = 1;
    }
    // Add the carry to the whole part, right to left.
    var w = std::string::len(whole) - 1;
    var carried = std::string::empty();
    while w >= 0 {
        let d = std::string::byte_at(whole, w) - 48 + carry;
        if d == 10 {
            std::string::push_byte(carried, 48);
            carry = 1;
        } else {
            std::string::push_byte(carried, 48 + d);
            carry = 0;
        }
        w = w - 1;
    }
    if carry == 1 || std::string::len(carried) == 0 {
        std::string::push_byte(carried, 48 + carry);
    }
    if negative {
        std::string::push_byte(out_whole, 45);
    }
    var r = std::string::len(carried) - 1;
    var leading = true;
    while r >= 0 {
        let b = std::string::byte_at(carried, r);
        if !(leading && b == 48 && r > 0) {
            leading = false;
            std::string::push_byte(out_whole, b);
        }
        r = r - 1;
    }
    std::string::push_byte(out_whole, 46);
    std::string::push_byte(out_whole, 48 + c0);
    std::string::push_byte(out_whole, 48 + c1);
    out_whole
}

/// Apply filter `name` to `value` with string arguments.
///
/// # Example
/// ```tuo
/// let v = jinja::filters::apply("currency", amount, args);
/// ```
pub fn apply(in name: Str, in value: jinja::expr::Value, in args: Array[String]) -> jinja::expr::Value {
    if name == "currency" {
        var code = std::string::from_str("EUR");
        if std::array::len(args) > 0 {
            code = std::string::from_str(std::string::as_str(std::array::get(args, 0)));
        }
        let fixed = two_decimals(std::string::as_str(value.text));
        var out = std::string::empty();
        if std::string::len(fixed) > 0 {
            std::string::append(out, std::string::as_str(fixed));
        } else {
            std::string::append(out, std::string::as_str(jinja::expr::printed(value, false)));
        }
        std::string::push_byte(out, 32);
        std::string::append(out, std::string::as_str(code));
        return jinja::expr::string_value(std::string::as_str(out), false);
    }
    if name == "safe" {
        return jinja::expr::string_value(std::string::as_str(jinja::expr::printed(value, false)), true);
    }
    if name == "e" || name == "escape" {
        return jinja::expr::string_value(std::string::as_str(jinja::expr::printed(value, true)), true);
    }
    if name == "upper" {
        return jinja::expr::string_value(std::string::as_str(std::str::to_upper(std::string::as_str(jinja::expr::printed(value, false)))), value.safe);
    }
    if name == "lower" {
        return jinja::expr::string_value(std::string::as_str(std::str::to_lower(std::string::as_str(jinja::expr::printed(value, false)))), value.safe);
    }
    if name == "trim" {
        return jinja::expr::string_value(std::str::trim(std::string::as_str(jinja::expr::printed(value, false))), value.safe);
    }
    if name == "length" {
        return jinja::expr::string_value(std::string::as_str(std::str::to_string(web::coerce::char_count(std::string::as_str(jinja::expr::printed(value, false))))), false);
    }
    if name == "default" {
        if value.kind == jinja::expr::kind_undefined() {
            if std::array::len(args) > 0 {
                return jinja::expr::string_value(std::string::as_str(std::array::get(args, 0)), false);
            }
            return jinja::expr::string_value("", false);
        }
        return jinja::expr::string_value(std::string::as_str(jinja::expr::printed(value, false)), value.safe);
    }
    jinja::expr::string_value(std::string::as_str(jinja::expr::printed(value, false)), value.safe)
}

fn fixed_is(in text: Str, in expected: Str) -> Bool {
    std::string::as_str(two_decimals(text)) == expected
}

spec two_decimals {
    then fixed_is("12.5", "12.50");
    then fixed_is("49", "49.00");
    then fixed_is("9.99", "9.99");
    then fixed_is("0.005", "0.01");
    then fixed_is("9.999", "10.00");
    then fixed_is("-1.5", "-1.50");
    then fixed_is(".5", "0.50");
    then fixed_is("1.", "1.00");
    then fixed_is("nope", "");
    then fixed_is("", "");
    then fixed_is("1.2.3", "");
}
