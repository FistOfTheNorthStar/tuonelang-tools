/// The ECDHE shared secret X25519 produces from either private key and the
/// other's public key — the IKM of the handshake extract. Given here so the
/// key schedule can be spec'd without a curve operation, which exceeds the
/// spec sandbox's fuel; the curve operation itself is asserted natively by
/// `examples/tls.tuo`.
///
/// # Example
/// ```tuo
/// let s = tls::fixture::bytes(tls::fixture::shared_secret()); // 32 bytes
/// ```
pub fn shared_secret() -> Str {
    "8bd4054fb55b9d63fdfbacf9f04b9f0d35e6d63f537563efd46272900f89492d"
}

/// The test certificate, DER: self-signed Ed25519, `CN=localhost`, valid
/// for a hundred years from 2026-09-15.
///
/// # Example
/// ```tuo
/// let der = tls::fixture::bytes(tls::fixture::test_certificate()); // 322 bytes
/// ```
pub fn test_certificate() -> Str {
    ""
}

/// The test certificate's Ed25519 private seed. A TEST KEY: it signs for
/// this repository's oracle servers and nothing else.
///
/// # Example
/// ```tuo
/// let seed = tls::fixture::bytes(tls::fixture::test_seed()); // 32 bytes
/// ```
pub fn test_seed() -> Str {
    "171f2960631c359a5ee96e378afdf61630503c63cf74d675a7b76d09e3447ce0"
}

/// The test certificate's Ed25519 public key, as OpenSSL prints it — what
/// a client pins. `examples/tls.tuo` asserts natively that `test_seed`
/// produces it.
///
/// # Example
/// ```tuo
/// let pin = tls::fixture::bytes(tls::fixture::test_public_key()); // 32 bytes
/// ```
pub fn test_public_key() -> Str {
    "cf2097bae627caec3a6a5e7fcb13bf10c119d8e9a73d0492889e2fb4f0ee2ce9"
}

spec bytes {
    then std::array::len(bytes("0304")) == 2;
    then std::array::get(bytes("0304"), 1) == 4;
    then std::array::get(bytes("ff"), 0) == 255;
    then std::array::len(bytes("abc")) == 0;
    then std::array::len(bytes("zz")) == 0;
    then std::string::as_str(hex(bytes("00ff10"))) == "00ff10";
    then std::array::len(bytes(client_hello())) == 196;
    then std::array::len(bytes(server_hello())) == 90;
    then std::array::len(bytes(certificate())) == 445;
    then std::array::len(bytes(client_private())) == 32;
    then std::array::len(bytes(test_certificate())) == 322;
    then std::array::len(bytes(test_seed())) == 32;
    // The test certificate is what it says: an Ed25519 certificate carrying
    // the public key OpenSSL printed for it. (That the seed produces this
    // key, and that the RFC's private keys produce its public keys, are
    // curve operations beyond the sandbox's fuel: `examples/tls.tuo`
    // asserts both natively.)
    then std::der::certificate_is_ed25519(bytes(test_certificate()));
    then std::string::as_str(hex(std::der::certificate_public_key(bytes(test_certificate())))) == test_public_key();
    then std::array::len(bytes(shared_secret())) == 32;
    then std::array::len(bytes(test_public_key())) == 32;
}
