// tls::fixture — RFC 8448's handshake trace, and a test certificate.
//
// RFC 8448 walks one complete TLS 1.3 handshake with every byte printed:
// both ephemeral keys, every handshake message, and every secret the key
// schedule derives from them. That trace uses TLS_AES_128_GCM_SHA256 and an
// RSA certificate — neither of which this crate speaks — but the key
// schedule is a function of SHA-256 and the transcript alone, so every
// secret, every IV, and both Finished values are reproducible here from the
// RFC's own private key and messages. `tls::handshake`'s specs do exactly
// that. (The AES keys are not comparable: HKDF-Expand-Label folds the
// requested length into its input, and a 16-byte AES key is not a prefix of
// a 32-byte ChaCha20 key.)
//
// The test certificate at the end is a self-signed Ed25519 certificate for
// `CN=localhost`, generated with OpenSSL 3.6 on 2026-09-15 for the loopback
// and OpenSSL oracles. Its private seed is committed on purpose: it
// authenticates nothing but this repository's own test servers, and a
// reproducible oracle needs a reproducible key.
//
// Every value is a lowercase hex `Str`; `bytes` decodes one.

module tls::fixture;

/// The value of one hex digit, or -1.
fn nibble(take b: Int) -> Int {
    if b >= 48 && b <= 57 {
        return b - 48;
    }
    if b >= 97 && b <= 102 {
        return b - 87;
    }
    if b >= 65 && b <= 70 {
        return b - 55;
    }
    0 - 1
}

/// The bytes a hex string spells; empty for an odd length or a non-digit.
///
/// # Example
/// ```tuo
/// let b = tls::fixture::bytes("0304"); // [3, 4]
/// ```
pub fn bytes(in hex: Str) -> Array[Int] {
    var out = std::array::empty();
    let n = std::str::len(hex);
    if n % 2 != 0 {
        return out;
    }
    var i = 0;
    while i < n {
        let hi = nibble(std::str::byte_at(hex, i));
        let lo = nibble(std::str::byte_at(hex, i + 1));
        if hi < 0 || lo < 0 {
            return std::array::empty();
        }
        std::array::push(out, hi * 16 + lo);
        i = i + 2;
    }
    out
}

/// Lowercase hex of `data`, the inverse of `bytes`.
///
/// # Example
/// ```tuo
/// let h = tls::fixture::hex(tls::fixture::bytes("0304")); // "0304"
/// ```
pub fn hex(in data: Array[Int]) -> String {
    std::crypto::to_hex(data)
}

/// The client's ephemeral X25519 private key (RFC 8448 §3).
///
/// # Example
/// ```tuo
/// let b = tls::fixture::bytes(tls::fixture::client_private()); // 32 bytes
/// ```
pub fn client_private() -> Str {
    "49af42ba7f7994852d713ef2784bcbcaa7911de26adc5642cb634540e7ea5005"
}

/// The client's X25519 public key — the key_share it offers.
///
/// # Example
/// ```tuo
/// let b = tls::fixture::bytes(tls::fixture::client_public()); // 32 bytes
/// ```
pub fn client_public() -> Str {
    "99381de560e4bd43d23d8e435a7dbafeb3c06e51c13cae4d5413691e529aaf2c"
}

/// The server's ephemeral X25519 private key.
///
/// # Example
/// ```tuo
/// let b = tls::fixture::bytes(tls::fixture::server_private()); // 32 bytes
/// ```
pub fn server_private() -> Str {
    "b1580eeadf6dd589b8ef4f2d5652578cc810e9980191ec8d058308cea216a21e"
}

/// The server's X25519 public key — the key_share in its ServerHello.
///
/// # Example
/// ```tuo
/// let b = tls::fixture::bytes(tls::fixture::server_public()); // 32 bytes
/// ```
pub fn server_public() -> Str {
    "c9828876112095fe66762bdbf7c672e156d6cc253b833df1dd69b1b04e751f0f"
}

/// The ClientHello handshake message, 196 bytes, offering three suites and many groups.
///
/// # Example
/// ```tuo
/// let b = tls::fixture::bytes(tls::fixture::client_hello()); // 196 bytes
/// ```
pub fn client_hello() -> Str {
    ""
}

/// The ServerHello handshake message, 90 bytes: TLS_AES_128_GCM_SHA256 and an X25519 share.
///
/// # Example
/// ```tuo
/// let b = tls::fixture::bytes(tls::fixture::server_hello()); // 90 bytes
/// ```
pub fn server_hello() -> Str {
    "020000560303a6af06a4121860dc5e6e60249cd34c95930c8ac5cb1434dac155772ed3e2692800130100002e00330024001d0020c9828876112095fe66762bdbf7c672e156d6cc253b833df1dd69b1b04e751f0f002b00020304"
}

