// examples/numpy_sqrt — numpy::ieee::sqrt against its digit-by-digit reference.
//
//     tuo run --release examples/numpy_sqrt.tuo src/numpy/ieee.tuo src/std_str.tuo
//
// `sqrt` scales by powers of four, so its arithmetic on `x` is its
// arithmetic on `x`'s significand in [1, 4): every float32 there is
// checked, which is every normal float32; so is every float32 subnormal.
// Doubles are sampled: uniformly over the exponent range, and built to lie
// next to a rounding midpoint, where a root one unit off is likeliest.
// Exit is the number of disagreements.

module numpy_sqrt_check;

struct Lcg {
    x: Int,
}

fn next(mut g: Lcg) -> Int {
    g.x = (g.x * 1103515245 + 12345) % 2147483648;
    g.x
}

/// 52 random bits.
fn bits52(mut g: Lcg) -> Int {
    let hi = next(g) >> 5;
    let lo = next(g) >> 5;
    (hi << 26) + lo
}

fn line(in label: Str, take n: Int, take bad: Int) {
    var out = std::string::empty();
    if bad == 0 {
        std::str::push(out, "ok    ");
    } else {
        std::str::push(out, "FAIL  ");
    }
    std::str::push(out, label);
    std::str::push(out, ": ");
    std::str::push_int(out, n);
    std::str::push(out, " roots, ");
    std::str::push_int(out, bad);
    std::str::push(out, " differ\n");
    let _ = std::rt::write_string(1, out);
}

fn differs(take x: Float) -> Int {
    let fast = numpy::ieee::sqrt(x);
    let slow = numpy::ieee::sqrt_digits(x);
    if fast == slow {
        return 0;
    }
    var out = std::string::from_str("      x = ");
    std::str::push(out, std::string::as_str(numpy::ieee::hex64(x)));
    std::str::push(out, " sqrt = ");
    std::str::push(out, std::string::as_str(numpy::ieee::hex64(fast)));
    std::str::push(out, " reference = ");
    std::str::push(out, std::string::as_str(numpy::ieee::hex64(slow)));
    std::str::push(out, "\n");
    let _ = std::rt::write_string(1, out);
    1
}

fn main() -> Int {
    var failed = 0;

    // Every float32 significand in [1, 2) and [2, 4).
    var bad = 0;
    var i = 0;
    while i < 8388608 {
        let frac = (i as Float) * 0.00000011920928955078125;
        bad = bad + differs(1.0 + frac) + differs(2.0 + 2.0 * frac);
        i = i + 1;
    }
    line("every float32 in [1, 4)", 16777216, bad);
    failed = failed + bad;

    // Every float32 subnormal.
    bad = 0;
    i = 1;
    while i < 8388608 {
        bad = bad + differs(numpy::ieee::scale(i as Float, 0 - 149));
        i = i + 1;
    }
    line("every float32 subnormal", 8388607, bad);
    failed = failed + bad;

    // Random doubles over the whole exponent range, subnormals included.
    var g = Lcg { x: 7 };
    bad = 0;
    i = 0;
    while i < 4000000 {
        let m = bits52(g);
        let e = next(g) % 2098 - 1074;
        var x = numpy::ieee::scale((m + 4503599627370496) as Float, e - 52);
        if e < 0 - 1022 {
            x = numpy::ieee::scale(m as Float, 0 - 1074);
        }
        if x > 0.0 && x <= numpy::ieee::max64() {
            bad = bad + differs(x);
        }
        i = i + 1;
    }
    line("random doubles", 4000000, bad);
    failed = failed + bad;

    // Doubles whose root lies next to a midpoint: x = (q + 1/2)^2 / 2^104,
    // rounded, for random 53-bit q.
    bad = 0;
    i = 0;
    while i < 4000000 {
        let q = (bits52(g) + 4503599627370496) as Float;
        let m = q * 0.0000000000000002220446049250313;
        let x = m * m + m * 0.0000000000000002220446049250313;
        bad = bad + differs(x) + differs(numpy::ieee::scale(x, 1));
        i = i + 1;
    }
    line("doubles next to a midpoint", 8000000, bad);
    failed = failed + bad;

    // Exact squares and their neighbours.
    bad = 0;
    i = 1;
    while i < 2000000 {
        let r = i as Float;
        let sq = r * r;
        bad = bad + differs(sq) + differs(sq + 1.0) + differs(sq - 1.0);
        i = i + 1;
    }
    line("squares and their neighbours", 5999997, bad);
    failed = failed + bad;
    failed
}
